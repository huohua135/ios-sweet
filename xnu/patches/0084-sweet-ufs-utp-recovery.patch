+
+/*
+ * UFSHCI calls a UTP error fatal: the host stops fetching transfer requests
+ * until the controller is reset.  The bootloader left IS.UTPE set here, so do
+ * what Linux's ufshcd_hba_enable() does: drop HCE, re-program the request list
+ * base, raise HCE again, and restart the UniPro link if it went down with it.
+ */
+static int
+ufs_uic(uint32_t cmd, uint32_t arg1)
+{
+	ufs_wr(REG_IS, ufs_rd(REG_IS));        /* clear UCCS */
+	ufs_wr(REG_UICARG1, arg1);
+	ufs_wr(REG_UICARG2, 0);
+	ufs_wr(REG_UICARG3, 0);
+	ufs_wr(REG_UICCMD, cmd);
+	for (int i = 0; i < 1000; i++) {
+		if (ufs_rd(REG_IS) & IS_UCCS) {
+			return (int)((ufs_rd(REG_UICCMD) >> 16) & 0xff);
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+static void
+ufs_hba_reset(void)
+{
+	uint64_t list = su.dma_pa + DMA_UTRL;
+
+	printf("SWEET UFS: reset: before hce 0x%x hcs 0x%x is 0x%x\n",
+	    ufs_rd(REG_HCE), ufs_rd(REG_HCS), ufs_rd(REG_IS));
+	ufs_wr(REG_HCE, 0);
+	delay(10);
+	ufs_wr(REG_UTRLRSR, 0);
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLCLR, ~0u);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_HCE, 1);
+	for (int i = 0; i < 200; i++) {
+		if (ufs_rd(REG_HCS) & HCS_UCRDY) {
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET UFS: reset: after hce 0x%x hcs 0x%x is 0x%x\n",
+	    ufs_rd(REG_HCE), ufs_rd(REG_HCS), ufs_rd(REG_IS));
+	if (!(ufs_rd(REG_HCS) & HCS_DP)) {
+		int r;
+		printf("SWEET UFS: link down, rebuilding it\n");
+		r = ufs_uic(UIC_DME_RESET, 1);
+		printf("SWEET UFS: DME_RESET -> %d\n", r);
+		r = ufs_uic(UIC_DME_ENABLE, 0);
+		printf("SWEET UFS: DME_ENABLE -> %d\n", r);
+		r = ufs_uic(UIC_DME_LINKSTARTUP, 1);
+		printf("SWEET UFS: DME_LINKSTARTUP -> %d\n", r);
+		for (int i = 0; i < 2000 && !(ufs_rd(REG_HCS) & HCS_DP); i++) {
+			delay(1);
+		}
+		printf("SWEET UFS: link hcs 0x%x\n", ufs_rd(REG_HCS));
+	}
 }
 
 static int
