+#define IS_UCCS         (1u << 8)       /* UIC command completion */
+#define IS_UTPE         (1u << 10)      /* UTP error: fatal, needs a reset */
+#define UIC_DME_RESET       0x14
+#define UIC_DME_ENABLE      0x12
+#define UIC_DME_LINKSTARTUP 0x16
