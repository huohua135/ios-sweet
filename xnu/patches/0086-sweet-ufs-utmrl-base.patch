diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -64,6 +64,10 @@
 #define REG_UTRLDBR     0x58
 #define REG_UTRLCLR     0x5c
 #define REG_UTRLRSR     0x60
+#define REG_UTMRLBA     0x64
+#define REG_UTMRLBAU    0x68
+#define REG_UTMRLDBR    0x6c
+#define REG_UTMRLRSR    0x70
 #define REG_UICCMD      0x80
 #define REG_UICARG1     0x84
 #define REG_UICARG2     0x88
@@ -104,6 +108,7 @@
 
 /* Layout of the contiguous DMA allocation. */
 #define DMA_UTRL        0x0000                  /* 1 KiB aligned */
+#define DMA_UTMRL       0x2000                  /* 1 KiB aligned, task mgmt list */
 #define DMA_UCD         0x1000                  /* 128 byte aligned */
 #define DMA_BOUNCE      0x4000
 #define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
@@ -430,16 +435,31 @@
 	ufs_wr(REG_HCE, 0);
 	delay(10);
 	ufs_wr(REG_UTRLRSR, 0);
+	ufs_wr(REG_UTMRLRSR, 0);
+	/* Both request list bases must be valid before UCRDY can come back. */
+	bzero((void *)(su.dma + DMA_UTMRL), 0x400);
+	dma_sync(DMA_UTMRL, 0x400);
+	uint64_t utmrl = su.dma_pa + DMA_UTMRL;
 	ufs_wr(REG_UTRLBA, (uint32_t)list);
 	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTMRLBA, (uint32_t)utmrl);
+	ufs_wr(REG_UTMRLBAU, (uint32_t)(utmrl >> 32));
 	ufs_wr(REG_UTRLCLR, ~0u);
-	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTMRLDBR, ~0u);
+	ufs_wr(REG_IS, 0xffffffffu);
 	ufs_wr(REG_HCE, 1);
-	for (int i = 0; i < 200; i++) {
+	for (int i = 0; i < 1000; i++) {
 		if (ufs_rd(REG_HCS) & HCS_UCRDY) {
 			break;
 		}
+		if ((i % 250) == 249) {
+			printf("SWEET UFS: waiting for UCRDY, hcs 0x%x is 0x%x\n",
+			    ufs_rd(REG_HCS), ufs_rd(REG_IS));
+		}
 		delay(1);
+	}
+	if (ufs_rd(REG_HCS) & HCS_UCRDY) {
+		ufs_wr(REG_UTMRLRSR, 1);
 	}
 	printf("SWEET UFS: reset: after hce 0x%x hcs 0x%x is 0x%x\n",
 	    ufs_rd(REG_HCE), ufs_rd(REG_HCS), ufs_rd(REG_IS));
