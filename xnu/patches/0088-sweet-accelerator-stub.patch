+/*
+ * IOAcceleratorES stub: backboardd matches an accelerator and retries
+ * forever when none exists, so IOMobileFramebuffer is never opened and the
+ * display stays on the kernel console. Publish an inert accelerator (and a
+ * child named IOAccelerator) with a permissive user client.
+ */
+class IOAcceleratorStubUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOAcceleratorStubUserClient);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorStubUserClient, IOUserClient);
+
+bool
+IOAcceleratorStubUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	return IOUserClient::initWithTask(owningTask, securityID, type);
+}
+
+IOReturn
+IOAcceleratorStubUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOAcceleratorStubUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference)
+{
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	IOLog("SWEET GPU: stub sel %u\n", selector);
+	return kIOReturnSuccess;
+}
+
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+bool
+IOAcceleratorES::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	registerService();
+	return true;
+}
+
+static void
+sweet_accelerator_publish(IOService *provider)
+{
+	static bool published = false;
+
+	if (published || provider == NULL) {
+		return;
+	}
+	published = true;
+	IOAcceleratorES *es = OSTypeAlloc(IOAcceleratorES);
+	if (es == NULL) {
+		return;
+	}
+	if (!es->init() || !es->attach(provider)) {
+		es->release();
+		return;
+	}
+	es->setProperty(kIOUserClientClassKey, "IOAcceleratorStubUserClient");
+	es->registerService();
+	IOService *acc = OSTypeAlloc(IOService);
+	if (acc != NULL && acc->init() && acc->attach(es)) {
+		acc->setProperty("IOClass", "IOAccelerator");
+		acc->setProperty(kIOUserClientClassKey, "IOAcceleratorStubUserClient");
+		acc->registerService();
+	}
+	IOLog("SWEET GPU: IOAcceleratorES stub published\n");
+}
